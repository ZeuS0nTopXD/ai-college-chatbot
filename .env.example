# Local default. Replace with a MySQL or PostgreSQL SQLAlchemy URL if needed.
# Neon example: postgresql+psycopg://user:password@host/dbname?sslmode=require
APP_ENV=development
DATABASE_URL=sqlite:///./data/vsit_student_assistant.db

# Change both values before any shared or cloud deployment.
ADMIN_PASSWORD=change-me
TOKEN_SECRET=development-secret-change-me-before-deploying
TOKEN_TTL_MINUTES=60

# Document uploads (10 MiB by default).
MAX_UPLOAD_BYTES=10485760
DOCUMENT_STORAGE_PATH=./data/documents

# Optional local language model.
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2:3b

# Comma-separated frontend origins.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
